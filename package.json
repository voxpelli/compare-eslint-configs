{
  "name": "compare-eslint-configs",
  "version": "3.0.0",
  "description": "Compares ESLint configs",
  "homepage": "http://github.com/voxpelli/compare-eslint-configs",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/compare-eslint-configs.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "compare",
    "diff",
    "audit",
    "migration",
    "cli"
  ],
  "author": "Pelle Wessman <pelle@kodfabrik.se> (http://kodfabrik.se/)",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "typescript": ">=5.9"
  },
  "type": "module",
  "bin": {
    "compare-eslint-configs": "cli.js"
  },
  "files": [
    "cli.js",
    "lib/**/*.cjs",
    "lib/**/*.js"
  ],
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build": "run-s build:*",
    "check:installed-check": "installed-check",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/*'",
    "check": "run-s clean && run-p check:*",
    "clean:declarations-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.d.*ts*')",
    "clean:declarations-lib": "rm -rf $(find lib -type f -name '*.d.*ts*' ! -name '*-types.d.ts')",
    "clean": "run-p clean:*",
    "husky-enable": "husky",
    "husky-disable": "git config --unset core.hooksPath",
    "prepublishOnly": "run-s build",
    "test:node": "c8 --reporter=lcov --reporter=text node --test",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*",
    "try": "node cli.js compare new.eslint.config.js -f cli.js",
    "try-table": "node cli.js summary new.eslint.config.js -f cli.js -m --table"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.17",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.2.1",
    "c8": "^11.0.0",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^6.4.1",
    "npm-run-all2": "^8.0.4",
    "type-coverage": "^2.29.7",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@voxpelli/deep-diff-value": "^1.0.0",
    "@voxpelli/typed-utils": "^4.0.0",
    "ajv": "^6.12.6",
    "chalk": "^5.2.0",
    "eslint": "^9.13.0 || ^10.0.0",
    "fast-deep-equal": "^3.1.3",
    "markdown-or-chalk": "^0.2.3",
    "peowly": "^1.3.2",
    "peowly-commands": "^1.1.0",
    "pony-cause": "^2.1.11"
  }
}
